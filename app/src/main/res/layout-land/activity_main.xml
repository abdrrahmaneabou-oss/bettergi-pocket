<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/pocket_on_primary">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:padding="24dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="16dp">
            <ImageView android:layout_width="80dp" android:layout_height="80dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_overlay_bubble"/>
            <TextView style="@style/Pocket.Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="مساعد جينشن"/>
            <TextView style="@style/Pocket.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="BetterGI Pocket"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_pocket_group">
            <TextView style="@style/Pocket.Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تفعيل المساعد داخل اللعبة"/>
            <TextView style="@style/Pocket.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="النافذة العائمة · مطلوبة الآن"/>
            <TextView style="@style/Pocket.Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="إظهار فقاعة المساعد والمسارات والحالة داخل اللعبة."/>
            <TextView style="@style/Pocket.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="مشاركة الشاشة · عند التفعيل"/>
            <TextView style="@style/Pocket.Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="تُطلب عند تشغيل مشاركة الشاشة للتعرف على صورة اللعبة."/>
            <TextView style="@style/Pocket.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="إمكانية الوصول · عند الحاجة"/>
            <TextView style="@style/Pocket.Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="مطلوبة للحوارات التلقائية وتتبع الخريطة. فعّلها عند الحاجة."/>
            <Button android:id="@+id/btn_request_overlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginTop="16dp" android:textSize="12sp" android:text="تفعيل النافذة العائمة" android:textColor="@color/pocket_on_primary" android:backgroundTint="@color/pocket_primary"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
